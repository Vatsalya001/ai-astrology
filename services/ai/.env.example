# ai-service — LLM orchestration, RAG, safety and evaluation.
#
# Copy to .env for running this service standalone.

ENV=development
AI_PORT=8200
LOG_LEVEL=info

INTERNAL_TOKEN=dev-internal-token-change-me

# ─── Database ───────────────────────────────────────────────────
# READ-ONLY role. api-service is the sole writer (ADR-001). This is
# enforced by Postgres grants, so pointing this at the writable role
# still would not let the service write — but a production startup guard
# rejects it anyway, because the intent would be wrong.
AI_DATABASE_URL=postgresql://astro_ro:astro_ro@localhost:5433/astro_dev

# ─── Model provider ─────────────────────────────────────────────
# Development runs free models locally through Ollama's
# OpenAI-compatible endpoint. Production MUST use a paid provider:
# the process refuses to start otherwise, because requests carry birth
# data and personal conversation content, and most free tiers may train
# on their inputs. See app/guards.py and ADR-004.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_PROVIDER_TIER=local

# To run against Gemini's free tier instead, replace the four lines
# above with these three and nothing else:
#
#   LLM_PROVIDER=google
#   LLM_PROVIDER_TIER=free-hosted
#   LLM_API_KEY=<a key from https://aistudio.google.com/apikey>
#
# Development and CI only. `free-hosted` is refused in production by
# app/guards.py, because a free tier may train on its inputs and these
# requests carry birth data.

# ─── Models: LEAVE THESE COMMENTED ──────────────────────────────
# Unset, each tier follows whichever provider is configured —
# app/settings.py DEFAULT_MODELS. Set, your value wins, for every
# provider, forever.
#
# These used to be uncommented, and that was a trap: changing only
# LLM_PROVIDER to `google` left `llama3.2:3b` pinned here and sent that
# name to the Gemini API, which answers `404 model not found`. The
# obvious readings of that are "my key is bad" and "the adapter is
# broken", and neither is true.
#
# Uncomment only to pin a specific model, and then remember you have.
# `uv run python -m scripts.diagnose_intent_loss` prints the provider
# and model it resolved before it starts, which is the fastest way to
# find out what is actually configured.
#
# LLM_MODEL_FAST=llama3.2:3b
# LLM_MODEL_CHAT=qwen2.5:7b
# LLM_MODEL_DEEP=qwen2.5:7b

# ─── Embeddings ─────────────────────────────────────────────────
# Never hardcode the dimension anywhere else. pgvector columns are
# fixed-dimension, so a mismatch means re-embedding the whole corpus.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Optional. Leave unset to disable.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Below this self-reported confidence, a classification is discarded and
# the request falls back to broad context.
#
# The spec (PHASE-04 §6) says 0.6. This ships 0.4 because the number is
# applied to a SELF-REPORTED confidence and small local models do not
# calibrate one — measured, 0.6 discarded ten of twelve answers
# llama3.2:1b got right.
#
# 0.4 is tuned to a weak local model. Production runs Claude, whose
# calibration is different and unmeasured, so raise this once Phase 6's
# eval harness has a number: INTENT_MIN_CONFIDENCE=0.6
INTENT_MIN_CONFIDENCE=0.4

# ─── Phase 4: provider chain ─────────────────────────────────────────
#
# The fallback is EMPTY by default and that is deliberate: a fallback
# nobody configured must not silently appear and start serving. Set both
# to enable it. ProviderRegistry runs the PII guard per link, so a
# free-tier fallback behind a paid primary is refused in production.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=

# Per-provider HTTP budget. FLOORED for a paid provider — see
# LLM_PAID_TIMEOUT_FLOOR_SECONDS — because a deep-tier interpretation on
# the largest model is the longest call this service makes, and wiring
# 60s straight through halved AnthropicProvider's own default.
LLM_TIMEOUT_SECONDS=60.0
LLM_PAID_TIMEOUT_FLOOR_SECONDS=120.0

# Retries belong to ResilientProvider, never to the vendor SDK: two SDK
# attempts inside three chain attempts is six calls to a dead provider.
LLM_MAX_RETRIES=2

# Five consecutive failures open the circuit for a minute. Retrying a
# provider that is down is worse than not retrying — every request pays
# the full timeout before failing over.
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RESET_SECONDS=60.0

# ─── Phase 4: prompts ────────────────────────────────────────────────
#
# Published versions are immutable; improvements become a new version.
# PROMPT_VERSION_INTENT is v2 because v1 never named its output fields,
# so a model answering correctly with the key `intent` instead of
# `primary` had its answer thrown away by validation. v1 stays frozen
# and loadable — that is what the immutability guarantee is for.
PROMPT_VERSION_CHAT=v1
PROMPT_VERSION_INTENT=v2
DEFAULT_PERSONA=vedic_guide

# ─── Phase 4: safety ─────────────────────────────────────────────────
#
# Both must stay true. Output validation is unconditional in
# app/orchestrator/pipeline.py — there is no code path behind these
# flags, and the startup guard REFUSES to boot on false rather than
# accepting a setting an operator would wrongly believe took effect.
SAFETY_VALIDATION_ENABLED=true
SAFETY_BLOCK_ON_FABRICATED_FACT=true

# Which region's helplines the crisis response offers. The response
# currently points at findahelpline.com for every region — see
# app/safety/responses/README.md for why the local numbers were removed
# and what putting them back requires.
CRISIS_HELPLINE_REGION=IN

