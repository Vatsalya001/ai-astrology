# ai-service — LLM orchestration, RAG, safety and evaluation.
#
# Copy to .env for running this service standalone.

ENV=development
AI_PORT=8200
LOG_LEVEL=info

INTERNAL_TOKEN=dev-internal-token-change-me

# ─── Database ───────────────────────────────────────────────────
# READ-ONLY role. api-service is the sole writer (ADR-001). This is
# enforced by Postgres grants, so pointing this at the writable role
# still would not let the service write — but a production startup guard
# rejects it anyway, because the intent would be wrong.
AI_DATABASE_URL=postgresql://astro_ro:astro_ro@localhost:5433/astro_dev

# ─── Model provider ─────────────────────────────────────────────
# Development runs free models locally through Ollama's
# OpenAI-compatible endpoint. Production MUST use a paid provider:
# the process refuses to start otherwise, because requests carry birth
# data and personal conversation content, and most free tiers may train
# on their inputs. See app/guards.py and ADR-004.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_PROVIDER_TIER=local

LLM_MODEL_FAST=llama3.2:3b
LLM_MODEL_CHAT=qwen2.5:7b
LLM_MODEL_DEEP=qwen2.5:7b

# ─── Embeddings ─────────────────────────────────────────────────
# Never hardcode the dimension anywhere else. pgvector columns are
# fixed-dimension, so a mismatch means re-embedding the whole corpus.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Optional. Leave unset to disable.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
