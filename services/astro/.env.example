# astro-service — deterministic Vedic astrology computation.
#
# Copy to .env for running this service standalone. The root .env.example
# covers the whole stack; this one exists so the service can be deployed
# or run on its own without inheriting variables it has no business
# knowing about.
#
# NOTE what is absent and must stay absent: any model provider URL, key
# or model name. This service must never be able to reach an LLM.
# See ADR-001 and tests/test_no_llm_imports.py.

ENV=development
ASTRO_PORT=8100
LOG_LEVEL=info

# Shared secret for service-to-service calls. Minimum 16 characters.
# Generate: openssl rand -hex 32
INTERNAL_TOKEN=dev-internal-token-change-me

# ─── Ephemeris (consumed from Phase 2) ──────────────────────────
# moseph = Moshier analytical ephemeris, built in. No data files, and
# accurate to ~0.1 arcsecond for 1800-2200 — far beyond what astrology
# needs. Use swieph with .se1 files for pre-1800 births.
EPHEMERIS_FLAG=moseph
EPHEMERIS_PATH=./data/ephe

DEFAULT_AYANAMSA=lahiri
DEFAULT_HOUSE_SYSTEM=whole_sign
DEFAULT_NODE_TYPE=mean

# Optional. Leave unset to disable error reporting.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
