# ════════════════════════════════════════════════════════════════
#  AI Astrology Companion — local development environment
#  Copy to .env and adjust. NEVER commit .env.
#  Every service validates its own config at startup and exits
#  with a named error if anything required is missing.
# ════════════════════════════════════════════════════════════════

# ─── Shared ─────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=debug

# Shared secret for service-to-service calls. Must be >= 16 chars.
# Generate a real one for anything non-local:  openssl rand -hex 32
INTERNAL_TOKEN=dev-internal-token-change-me

# ─── api-service (Go) ───────────────────────────────────────────
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

DATABASE_URL=postgresql://astro:astro@localhost:5433/astro_dev?sslmode=disable
DATABASE_MAX_CONNS=20
REDIS_URL=redis://localhost:6381

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=astro-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

ASTRO_SERVICE_URL=http://localhost:8100
AI_SERVICE_URL=http://localhost:8200
SERVICE_TIMEOUT=10s

# ─── Feature flags (Phase 0: everything off) ────────────────────
FEATURE_AI_CHAT_ENABLED=false
FEATURE_VOICE_ENABLED=false
FEATURE_HUMAN_ASTROLOGER_ENABLED=false
FEATURE_COMPATIBILITY_ENABLED=false
FEATURE_PAYMENTS_ENABLED=false
FEATURE_PDF_ENABLED=false

# ─── astro-service (Python) ─────────────────────────────────────
# NOTE: deliberately contains NO model provider config.
# This service must never be able to reach an LLM. See ADR-001.
ASTRO_PORT=8100
EPHEMERIS_FLAG=moseph
DEFAULT_AYANAMSA=lahiri
DEFAULT_HOUSE_SYSTEM=whole_sign
DEFAULT_NODE_TYPE=mean

# ─── ai-service (Python) ────────────────────────────────────────
AI_PORT=8200
# READ-ONLY role. ai-service must never write to the database.
AI_DATABASE_URL=postgresql://astro_ro:astro_ro@localhost:5433/astro_dev

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_PROVIDER_TIER=local
LLM_MODEL_FAST=llama3.2:3b
LLM_MODEL_CHAT=qwen2.5:7b
LLM_MODEL_DEEP=qwen2.5:7b

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ─── web (Next.js) ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
