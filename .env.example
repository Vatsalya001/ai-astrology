# ════════════════════════════════════════════════════════════════
#  AI Astrology Companion — local development environment
#  Copy to .env and adjust. NEVER commit .env.
#  Every service validates its own config at startup and exits
#  with a named error if anything required is missing.
# ════════════════════════════════════════════════════════════════

# ─── Shared ─────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=debug

# Shared secret for service-to-service calls. Must be >= 16 chars.
# Generate a real one for anything non-local:  openssl rand -hex 32
INTERNAL_TOKEN=dev-internal-token-change-me

# ─── api-service (Go) ───────────────────────────────────────────
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

DATABASE_URL=postgresql://astro:astro@localhost:5433/astro_dev?sslmode=disable
DATABASE_MAX_CONNS=20
REDIS_URL=redis://localhost:6381

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=astro-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# The browser the PDF worker drives. Empty disables PDF rendering.
# Named explicitly so a worker without a browser fails at startup
# rather than on the first user's download.
CHROME_PATH=/usr/bin/google-chrome

ASTRO_SERVICE_URL=http://localhost:8100
AI_SERVICE_URL=http://localhost:8200
SERVICE_TIMEOUT=10s
# Internal calls nobody is waiting on. The Sade Sati windows scan is ~22s
# by construction, so the interactive budget above could never fit it.
BATCH_SERVICE_TIMEOUT=120s

# Optional health probes. Reported by /health when set, omitted when not.
STORAGE_HEALTH_URL=http://localhost:9000/minio/health/live
MAIL_HEALTH_URL=http://localhost:8025/readyz

# ─── Observability (all optional; empty = disabled) ─────────────
# The instrumentation always runs; only export is conditional. That way
# these code paths cannot rot, and enabling them in staging is a config
# change rather than a code change.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1.0
SENTRY_DSN=

# ─── Feature flags (Phase 0: everything off) ────────────────────
FEATURE_AI_CHAT_ENABLED=false
FEATURE_VOICE_ENABLED=false
FEATURE_HUMAN_ASTROLOGER_ENABLED=false
FEATURE_COMPATIBILITY_ENABLED=false
FEATURE_PAYMENTS_ENABLED=false
FEATURE_PDF_ENABLED=false

# ─── astro-service (Python) ─────────────────────────────────────
# NOTE: deliberately contains NO model provider config.
# This service must never be able to reach an LLM. See ADR-001.
ASTRO_PORT=8100
EPHEMERIS_FLAG=moseph
DEFAULT_AYANAMSA=lahiri
DEFAULT_HOUSE_SYSTEM=whole_sign
DEFAULT_NODE_TYPE=mean

# ─── ai-service (Python) ────────────────────────────────────────
AI_PORT=8200
# READ-ONLY role. ai-service must never write to the database.
AI_DATABASE_URL=postgresql://astro_ro:astro_ro@localhost:5433/astro_dev

LLM_PROVIDER=openai-compatible
# `host.docker.internal`, NOT localhost — and the difference is the whole
# point of this comment.
#
# This file configures the CONTAINER (docker-compose.yml passes it
# through). Inside a container, `localhost` is the container, so
# `http://localhost:11434` points ai-service at its own empty port 11434
# rather than at the Ollama running on your machine. The symptom is not
# obviously a config problem: `POST /v1/complete` returns a 500 and the
# log says `every provider failed — openai-compatible unreachable`,
# which reads like Ollama being down.
#
# compose already defaults to this value and maps the name via
# `extra_hosts: host.docker.internal:host-gateway`. The default was
# right; this file was overriding it with the wrong one.
#
# Running ai-service directly on the host instead? That is
# `services/ai/.env.example`, where `localhost` IS correct.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_PROVIDER_TIER=local

# Left commented deliberately: unset, each tier follows whichever
# provider is configured (app/settings.py DEFAULT_MODELS). Pinned here,
# the value wins for every provider — so flipping LLM_PROVIDER to
# `google` would send `llama3.2:3b` to the Gemini API and get back a
# 404 that reads like a bad key. See services/ai/.env.example.
# LLM_MODEL_FAST=llama3.2:3b
# LLM_MODEL_CHAT=qwen2.5:7b
# LLM_MODEL_DEEP=qwen2.5:7b

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ─── web (Next.js) ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Auth (Phase 1) ──────────────────────────────────────────────────
# JWT_SECRET and IP_HASH_SALT have no defaults and no fallbacks. A shared
# default is the same as no secret, and the failure is silent because
# everything still works. Generate your own:
#   openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-change-me-32-bytes-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Raw IPs are never persisted; they are hashed with this salt first.
IP_HASH_SALT=dev-only-ip-salt-change-me

# console | smtp | sms
# `console` logs the code. The process refuses to start with it when
# ENV=production — a production log full of live OTPs.
AUTH_CHANNEL=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Ayana <noreply@localhost>"

OTP_LENGTH=6
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5

# Grace period before a deletion request is executed by the worker.
ACCOUNT_DELETE_GRACE=168h

# Tasks one worker replica runs at once. The transit refresh is a single
# six-hourly call; this exists for the PDF renderer in Phase 3.
WORKER_CONCURRENCY=2
