{
  "components": {
    "schemas": {
      "AIResponseEnvelope_CompleteResult_": {
        "properties": {
          "result": {
            "$ref": "#/components/schemas/CompleteResult"
          },
          "telemetry": {
            "$ref": "#/components/schemas/Telemetry"
          }
        },
        "required": [
          "result",
          "telemetry"
        ],
        "title": "AIResponseEnvelope[CompleteResult]",
        "type": "object"
      },
      "CompleteRequest": {
        "description": "What `api-service` sends.\n\n`user_id` and `conversation_id` are IDs. No name, no email, no birth\ndetails \u2014 `.claude/rules/security.md`. The chart comes from\n`astro-service` via the context builder, keyed by the ID, and never\ntravels through this request body.",
        "properties": {
          "conversation_id": {
            "default": "",
            "title": "Conversation Id",
            "type": "string"
          },
          "job": {
            "$ref": "#/components/schemas/JobType",
            "default": "chat_response"
          },
          "language": {
            "default": "en",
            "title": "Language",
            "type": "string"
          },
          "message": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "user_id": {
            "default": "",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "CompleteRequest",
        "type": "object"
      },
      "CompleteResult": {
        "properties": {
          "blocked": {
            "default": false,
            "title": "Blocked",
            "type": "boolean"
          },
          "declined": {
            "default": false,
            "title": "Declined",
            "type": "boolean"
          },
          "intent": {
            "$ref": "#/components/schemas/Intent",
            "default": "general_astrology"
          },
          "is_crisis_response": {
            "default": false,
            "title": "Is Crisis Response",
            "type": "boolean"
          },
          "safety_category": {
            "$ref": "#/components/schemas/SafetyCategory",
            "default": "none"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "CompleteResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "provider_tier": {
            "title": "Provider Tier",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "provider",
          "provider_tier"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Intent": {
        "description": "The 21 intents from PHASE-04 \u00a76.\n\n`StrEnum` so an intent survives a round trip through JSON, a log line\nand an admin dashboard as itself, rather than as an integer nobody\ncan read at 3am.",
        "enum": [
          "general_astrology",
          "career",
          "relationship",
          "marriage",
          "finance",
          "education",
          "family",
          "travel",
          "relocation",
          "daily_horoscope",
          "kundli",
          "dasha",
          "transit",
          "compatibility",
          "tarot",
          "numerology",
          "human_astrologer",
          "emotional_support",
          "medical",
          "legal",
          "other"
        ],
        "title": "Intent",
        "type": "string"
      },
      "JobType": {
        "description": "Every distinct thing this product asks a model to do.\n\n`StrEnum` so a job survives a round trip through JSON, an admin\noverride and a log line as itself rather than as an integer nobody\ncan read in a dashboard.",
        "enum": [
          "intent_classification",
          "safety_classification",
          "memory_extraction",
          "conversation_summary",
          "suggested_questions",
          "daily_horoscope",
          "chat_response",
          "chart_interpretation",
          "premium_report",
          "compatibility"
        ],
        "title": "JobType",
        "type": "string"
      },
      "RoutingOverride": {
        "description": "One admin change, validated before it reaches the router.\n\nA Pydantic model rather than a raw dict so an override arriving from\nthe Go admin panel with a typo'd job name fails at the boundary with\na readable message, rather than silently adding a key nothing reads.",
        "properties": {
          "job": {
            "$ref": "#/components/schemas/JobType"
          },
          "reason": {
            "default": "",
            "description": "Why. Shown in the admin UI next to the override, because a mapping that differs from the default without a stated reason is indistinguishable from a mistake six months later.",
            "title": "Reason",
            "type": "string"
          },
          "tier": {
            "enum": [
              "fast",
              "chat",
              "deep"
            ],
            "title": "Tier",
            "type": "string"
          }
        },
        "required": [
          "job",
          "tier"
        ],
        "title": "RoutingOverride",
        "type": "object"
      },
      "RoutingPatch": {
        "description": "One or more overrides, validated at the boundary.\n\nA Pydantic model rather than a raw dict so an override arriving from\nthe Go admin panel with a typo'd job name fails HERE with a readable\nmessage, rather than silently adding a key nothing reads.",
        "properties": {
          "overrides": {
            "items": {
              "$ref": "#/components/schemas/RoutingOverride"
            },
            "title": "Overrides",
            "type": "array"
          },
          "reset": {
            "default": false,
            "description": "Discard every override and return to DEFAULT_ROUTING. The other half of a runtime override: without it, the only way back from a bad change at 3am is the deploy the override existed to avoid.",
            "title": "Reset",
            "type": "boolean"
          }
        },
        "title": "RoutingPatch",
        "type": "object"
      },
      "RoutingResponse": {
        "description": "The table as it stands, and what differs from the default.\n\n`overridden` rather than only `table`, because the question an\noperator has is \"what did somebody change\", not \"what are all ten\nmappings\". \u00a74: a mapping that differs from the default without a\nstated reason is indistinguishable from a mistake six months later.",
        "properties": {
          "defaults": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/JobType"
            },
            "title": "Defaults",
            "type": "object"
          },
          "overridden": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/JobType"
            },
            "title": "Overridden",
            "type": "object"
          },
          "table": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/JobType"
            },
            "title": "Table",
            "type": "object"
          }
        },
        "required": [
          "table",
          "overridden",
          "defaults"
        ],
        "title": "RoutingResponse",
        "type": "object"
      },
      "SafetyCategory": {
        "enum": [
          "crisis",
          "medical",
          "legal",
          "prompt_injection",
          "abuse",
          "none"
        ],
        "title": "SafetyCategory",
        "type": "string"
      },
      "SafetyFlag": {
        "description": "One finding, without the text that produced it.",
        "properties": {
          "severity": {
            "title": "Severity",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "severity"
        ],
        "title": "SafetyFlag",
        "type": "object"
      },
      "Telemetry": {
        "description": "One row of `ai_request_logs`, assembled by Python.\n\nField names match the migration column-for-column on purpose. The Go\nside maps this straight through, and a rename on either side that\ndoes not happen on both is caught by the generated client rather\nthan by a column silently receiving zero.",
        "properties": {
          "cache_write_tokens": {
            "default": 0,
            "minimum": 0.0,
            "title": "Cache Write Tokens",
            "type": "integer"
          },
          "cached_tokens": {
            "default": 0,
            "minimum": 0.0,
            "title": "Cached Tokens",
            "type": "integer"
          },
          "context_version": {
            "default": "",
            "title": "Context Version",
            "type": "string"
          },
          "conversation_id": {
            "default": "",
            "title": "Conversation Id",
            "type": "string"
          },
          "cost_micros": {
            "default": 0,
            "format": "int64",
            "minimum": 0.0,
            "title": "Cost Micros",
            "type": "integer"
          },
          "finish_reason": {
            "default": "stop",
            "enum": [
              "stop",
              "length",
              "refusal",
              "error"
            ],
            "title": "Finish Reason",
            "type": "string"
          },
          "input_tokens": {
            "default": 0,
            "minimum": 0.0,
            "title": "Input Tokens",
            "type": "integer"
          },
          "intent": {
            "default": "",
            "title": "Intent",
            "type": "string"
          },
          "job_type": {
            "title": "Job Type",
            "type": "string"
          },
          "latency_ms": {
            "default": 0,
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "integer"
          },
          "model": {
            "default": "",
            "title": "Model",
            "type": "string"
          },
          "model_calls": {
            "default": 0,
            "minimum": 0.0,
            "title": "Model Calls",
            "type": "integer"
          },
          "output_tokens": {
            "default": 0,
            "minimum": 0.0,
            "title": "Output Tokens",
            "type": "integer"
          },
          "prompt_version": {
            "default": "",
            "title": "Prompt Version",
            "type": "string"
          },
          "provider_id": {
            "default": "",
            "title": "Provider Id",
            "type": "string"
          },
          "regenerated": {
            "default": false,
            "title": "Regenerated",
            "type": "boolean"
          },
          "safety_flags": {
            "items": {
              "$ref": "#/components/schemas/SafetyFlag"
            },
            "title": "Safety Flags",
            "type": "array"
          },
          "tier": {
            "default": "",
            "title": "Tier",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          },
          "user_id": {
            "default": "",
            "title": "User Id",
            "type": "string"
          },
          "validation_passed": {
            "default": true,
            "title": "Validation Passed",
            "type": "boolean"
          }
        },
        "required": [
          "trace_id",
          "job_type"
        ],
        "title": "Telemetry",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "LLM orchestration, RAG and safety. Internal only.",
    "title": "ai-service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness check.\n\nDeliberately does NOT probe the model provider. Two reasons:\n\n  * A health check that calls an LLM costs money on every poll and\n    adds seconds of latency to something that should take\n    milliseconds.\n  * Provider reachability is a runtime concern handled by the retry\n    and circuit-breaker logic in Phase 4, not a reason to mark this\n    process unhealthy and have it restarted.\n\nThe provider fields are reported so operators can see at a glance\nwhich backend is configured \u2014 useful when the answer to \"why is dev\noutput worse than prod?\" is \"dev is on a 3B local model\".",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/complete": {
      "post": {
        "description": "Run the pipeline and return the result with its telemetry.\n\nThe envelope goes back whole. Go writes `telemetry` to\n`ai_request_logs` in the same transaction as the message, which is\nwhat keeps a single writer and a single transaction boundary \u2014 and\nmeans a request that cost money can never be missing from the bill\nbecause a separate logging call failed.",
        "operationId": "complete_v1_complete_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIResponseEnvelope_CompleteResult_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Complete",
        "tags": [
          "ai"
        ]
      }
    },
    "/v1/routing": {
      "get": {
        "operationId": "get_routing_v1_routing_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoutingResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Routing",
        "tags": [
          "ai"
        ]
      },
      "patch": {
        "description": "\u00a717: \"Model router ... overridable from admin without deploy\".\n\nThe gate item said \"without a deploy\" and `ModelRouter` took\noverrides only in its constructor \u2014 which means a deploy \u2014 and the\n`PATCH /admin/ai/config` in \u00a710 did not exist. The whole mechanism\nwas a constructor argument that only tests ever passed.\n\nApplied over the defaults one job at a time. There is deliberately\nno \"replace the whole table\" operation: an operator changing one\nmapping must not be able to unroute the other nine by sending a\nshort object.",
        "operationId": "patch_routing_v1_routing_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoutingPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoutingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Patch Routing",
        "tags": [
          "ai"
        ]
      }
    }
  }
}
