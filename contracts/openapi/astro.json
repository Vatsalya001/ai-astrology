{
  "components": {
    "schemas": {
      "AscendantPosition": {
        "additionalProperties": false,
        "properties": {
          "degree": {
            "exclusiveMaximum": 30.0,
            "format": "double",
            "minimum": 0.0,
            "title": "Degree",
            "type": "number"
          },
          "longitude": {
            "description": "Sidereal ecliptic longitude",
            "exclusiveMaximum": 360.0,
            "format": "double",
            "minimum": 0.0,
            "title": "Longitude",
            "type": "number"
          },
          "nakshatra": {
            "title": "Nakshatra",
            "type": "string"
          },
          "pada": {
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Pada",
            "type": "integer"
          },
          "sign": {
            "title": "Sign",
            "type": "string"
          },
          "sign_index": {
            "description": "0 = Aries",
            "maximum": 11.0,
            "minimum": 0.0,
            "title": "Sign Index",
            "type": "integer"
          }
        },
        "required": [
          "longitude",
          "sign",
          "sign_index",
          "degree",
          "nakshatra",
          "pada"
        ],
        "title": "AscendantPosition",
        "type": "object"
      },
      "BirthData": {
        "additionalProperties": false,
        "description": "Everything needed to compute a chart.\n\nThe instant is a single aware UTC timestamp rather than a local date,\na local time and a zone. Go owns timezone resolution \u2014 its stdlib\ncarries the full historical tzdata, including the 1942-45 Indian\nwartime offset \u2014 and resolves it once when the profile is created.\nRe-deriving it here would be a second implementation of the hardest\npart of the problem, free to disagree with the first.",
        "properties": {
          "ayanamsa": {
            "default": "lahiri",
            "enum": [
              "lahiri",
              "raman",
              "kp"
            ],
            "title": "Ayanamsa",
            "type": "string"
          },
          "house_system": {
            "const": "whole_sign",
            "default": "whole_sign",
            "title": "House System",
            "type": "string"
          },
          "latitude": {
            "format": "double",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "format": "double",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude",
            "type": "number"
          },
          "time_accuracy": {
            "default": "exact",
            "enum": [
              "exact",
              "approximate",
              "unknown"
            ],
            "title": "Time Accuracy",
            "type": "string"
          },
          "utc_instant": {
            "description": "Birth instant in UTC. Must be timezone-aware.",
            "examples": [
              "1994-08-17T09:05:00Z"
            ],
            "format": "date-time",
            "title": "Utc Instant",
            "type": "string"
          }
        },
        "required": [
          "utc_instant",
          "latitude",
          "longitude"
        ],
        "title": "BirthData",
        "type": "object"
      },
      "ChartMeta": {
        "additionalProperties": false,
        "description": "Provenance. Every one of these fields answers \"why did it say that?\".",
        "properties": {
          "ayanamsa": {
            "title": "Ayanamsa",
            "type": "string"
          },
          "ayanamsa_value": {
            "format": "double",
