            "title": "Time Accuracy",
            "type": "string"
          }
        },
        "required": [
          "ayanamsa",
          "ayanamsa_value",
          "house_system",
          "engine_version",
          "computed_at",
          "time_accuracy"
        ],
        "title": "ChartMeta",
        "type": "object"
      },
