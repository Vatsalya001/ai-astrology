      "SadeSatiWindowsRequest": {
        "additionalProperties": false,
        "description": "All twelve windows at one instant.\n\nTwelve rather than one, because a Sade Sati window is a pure function\nof Saturn's motion and the natal Moon's SIGN \u2014 and there are only\ntwelve of those. api-service stores the twelve and serves every user\nfrom them, which is what lets the answer survive an astro outage: the\nalternative is a call to this service on the path of a question users\nask constantly.",
        "properties": {
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "ayanamsa": {
            "default": "lahiri",
            "enum": [
