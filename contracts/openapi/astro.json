            "type": "number"
          },
          "calculation_system": {
            "const": "vedic",
            "default": "vedic",
            "title": "Calculation System",
            "type": "string"
          },
          "computed_at": {
            "format": "date-time",
            "title": "Computed At",
            "type": "string"
          },
          "engine_version": {
            "title": "Engine Version",
            "type": "string"
          },
          "house_system": {
            "title": "House System",
            "type": "string"
          },
          "schema_version": {
            "default": 1,
